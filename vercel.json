{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["bom1"],
  "env": {
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "crons": [
    {
      "path": "/api/cron/run-jobs",
      "schedule": "30 0 * * *"
    }
  ],
  "github": {
    "enabled": true,
    "silent": false
  }
}
